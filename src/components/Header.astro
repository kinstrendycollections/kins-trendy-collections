---
const categories = [
  { name: 'Kitchen Utensils', slug: 'utensils' },
];
---

<div class="utility-bar">
  <div class="container utility-inner">
    <span>Pay on delivery available across Nairobi</span>
    <span>M-Pesa accepted at checkout</span>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">Kins Trendy <span>Collections</span></a>

    <form action="/search" method="get" class="search-form" role="search">
      <label for="site-search" class="visually-hidden">Search products</label>
      <input
        id="site-search"
        type="search"
        name="q"
        placeholder="Search for sufurias, plates, cutlery…"
      />
      <button type="submit" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
    </form>

    <a href="/cart" class="cart-link" aria-label="View cart">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="9" cy="21" r="1"/>
        <circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      <span id="cart-count" class="cart-count">0</span>
    </a>
  </div>

  <nav class="category-nav">
    <div class="container">
      <ul>
        {categories.map((c) => (
          <li><a href={`/category/${c.slug}`}>{c.name}</a></li>
        ))}
        <li class="coming-soon">Clothes, shoes &amp; electricals — coming soon</li>
      </ul>
    </div>
  </nav>
</header>

<style>
  .utility-bar {
    background: var(--color-primary-dark);
    color: #fff;
    font-size: 0.8rem;
  }
  .utility-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 7px 20px;
    flex-wrap: wrap;
  }

  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 16px 20px;
    flex-wrap: wrap;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    white-space: nowrap;
  }
  .logo span { color: var(--color-accent-dark); }

  .search-form {
    flex: 1;
    min-width: 200px;
    display: flex;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .search-form input {
    flex: 1;
    border: none;
    padding: 10px 14px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .search-form input:focus { outline: none; }
  .search-form button {
    background: var(--color-accent);
    border: none;
    padding: 0 16px;
    color: var(--color-primary-dark);
    cursor: pointer;
  }
  .search-form button:hover { background: var(--color-accent-dark); }

  .cart-link {
    position: relative;
    display: flex;
    color: var(--color-primary-dark);
  }
  .cart-count {
    position: absolute;
    top: -8px;
    right: -10px;
    background: var(--color-rust);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
    padding: 3px 5px;
    border-radius: 50%;
    min-width: 16px;
    text-align: center;
  }

  .category-nav {
    background: var(--color-primary);
  }
  .category-nav ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 10px 20px;
    flex-wrap: wrap;
  }
  .category-nav a {
    color: #fff;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .category-nav a:hover { color: var(--color-accent); }
  .coming-soon {
    color: rgba(255,255,255,0.55);
    font-size: 0.85rem;
    font-style: italic;
  }
</style>

<script>
  function updateCartCount() {
    const raw = localStorage.getItem('ktc-cart');
    const cart = raw ? JSON.parse(raw) : [];
    const count = cart.reduce((sum: number, item: { qty: number }) => sum + item.qty, 0);
    const el = document.getElementById('cart-count');
    if (el) el.textContent = String(count);
  }
  updateCartCount();
  window.addEventListener('ktc-cart-updated', updateCartCount);
</script>
