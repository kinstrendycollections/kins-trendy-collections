---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { fetchProducts } from '../lib/products.js';
import { phoneE164 } from '../lib/site.js';
import { liveCategories } from '../lib/categories.js';

const products = await fetchProducts();
// One shelf per category that has products, newest products first as stored.
const shelves = liveCategories(products).map((c) => {
  const items = products.filter((p) => p.category === c.slug);
  return { ...c, total: items.length, items: items.slice(0, 4) };
});
// Products still on an old category (e.g. legacy 'shoes') are not lost.
const known = new Set(shelves.map((s) => s.slug));
const others = products.filter((p) => !known.has(p.category)).slice(0, 4);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: 'Kins Trendy Collections',
  description:
    'Online store selling quality kitchen utensils with delivery across Kenya, plus M-Pesa payment.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Nairobi',
    addressCountry: 'KE',
  },
  priceRange: 'KES 500 - KES 5000',
  ...(phoneE164 ? { telephone: phoneE164 } : {}),
};
---

<Layout
  title="Kins Trendy Collections"
  description="Shop kitchen utensils, shoes and boots online in Kenya. Pay with M-Pesa, delivered across Kenya."
  structuredData={structuredData}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>Everyday essentials for your home and family, delivered to your door.</h1>
        <p>
          From sufurias and kitchen utensils to shoes, school shoes and boots,
          Kins Trendy Collections stocks what Kenyan households use every day.
          Order online and pay by M-Pesa.
        </p>
        <div class="hero-actions">
          <a href="#shop" class="btn btn-accent">Shop by Category</a>
          <a href="/contact" class="btn btn-outline">Contact Us</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 320 320" xmlns="http://www.w3.org/2000/svg">
          <circle cx="160" cy="180" r="95" fill="none" stroke="#1B4B66" stroke-width="8"/>
          <rect x="65" y="180" width="190" height="100" rx="10" fill="none" stroke="#1B4B66" stroke-width="8"/>
          <circle cx="160" cy="70" r="6" fill="#E8A33D"/>
          <circle cx="120" cy="90" r="4" fill="#E8A33D"/>
          <circle cx="200" cy="90" r="4" fill="#E8A33D"/>
        </svg>
      </div>
    </div>
  </section>

  <div id="shop">
    {shelves.map((shelf) => (
      <section class="container featured-section" id={shelf.slug}>
        <div class="shelf-head">
          <h2>{shelf.label}</h2>
          <a class="shelf-link" href={`/category/${shelf.slug}`}>
            View all {shelf.total > 4 ? `(${shelf.total})` : ''} &rarr;
          </a>
        </div>
        <div class="product-grid">
          {shelf.items.map((p) => (
            <ProductCard
              slug={p.slug}
              name={p.name}
              price={p.price}
              compareAtPrice={p.compareAtPrice}
              currency={p.currency}
              image={p.images[0]}
              inStock={p.inStock}
              category={p.category}
            />
          ))}
        </div>
      </section>
    ))}
    {others.length > 0 && (
      <section class="container featured-section">
        <div class="shelf-head"><h2>More products</h2></div>
        <div class="product-grid">
          {others.map((p) => (
            <ProductCard
              slug={p.slug}
              name={p.name}
              price={p.price}
              compareAtPrice={p.compareAtPrice}
              currency={p.currency}
              image={p.images[0]}
              inStock={p.inStock}
              category={p.category}
            />
          ))}
        </div>
      </section>
    )}
  </div>

  <section class="container trust-strip">
    <div>
      <h3>Pay your way</h3>
      <p>Pay securely with M-Pesa once we confirm your delivery fee.</p>
    </div>
    <div>
      <h3>Nairobi &amp; beyond</h3>
      <p>We deliver to any county in Kenya. Delivery fee is confirmed when you order.</p>
    </div>
    <div>
      <h3>Growing every month</h3>
      <p>Kitchen utensils, shoes and boots today. Clothes, electricals and hardware coming next.</p>
    </div>
  </section>

  <script>
    import '../scripts/cart.js';
  </script>
</Layout>

<style>
  .hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 40px;
    padding: 56px 20px;
  }
  .hero-copy p {
    color: var(--color-ink-soft);
    margin-bottom: 28px;
  }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-art svg { width: 100%; height: auto; max-width: 320px; margin: 0 auto; }

  .featured-section { padding: 36px 20px 8px; }
  .shelf-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .shelf-link { color: var(--color-primary); font-weight: 600; white-space: nowrap; }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .trust-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 48px 20px 64px;
  }
  .trust-strip h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .trust-strip p { color: var(--color-ink-soft); font-size: 0.92rem; margin: 0; }

  @media (max-width: 800px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-art { order: -1; max-width: 220px; margin: 0 auto; }
    .trust-strip { grid-template-columns: 1fr; }
  }
</style>
