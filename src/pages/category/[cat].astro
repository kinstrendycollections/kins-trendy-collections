---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { fetchProducts } from '../../lib/products.js';
import { categoryLabel, categoryGroup, liveCategories } from '../../lib/categories.js';

export async function getStaticPaths() {
  const products = await fetchProducts();
  const categories = [...new Set(products.map((p) => p.category))];
  return categories.map((cat) => ({
    params: { cat },
    props: { cat, products },
  }));
}

const { cat, products } = Astro.props;
const items = products.filter((p) => p.category === cat);

const label = categoryLabel(cat);

// Other live categories in the same group (e.g. Men's Shoes <-> Ladies' Shoes <-> Gumboots)
const group = categoryGroup(cat);
const related = group
  ? liveCategories(products).filter((c) => c.group === group && c.slug !== cat)
  : [];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${label} — Kins Trendy Collections`,
  description: `Shop ${label.toLowerCase()} online with delivery across Kenya. Pay with M-Pesa.`,
};
---

<Layout
  title={label}
  description={`Buy ${label.toLowerCase()} online in Kenya. Delivered across Kenya, pay with M-Pesa.`}
  structuredData={structuredData}
>
  <div class="container category-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <span>{label}</span>
    </nav>
    <h1>{label}</h1>
    <p class="result-count">{items.length} {items.length === 1 ? 'product' : 'products'}</p>
    {related.length > 0 && (
      <p class="also-in">
        Also in {group}:
        {related.map((c, i) => (
          <>{i > 0 ? ' · ' : ' '}<a href={`/category/${c.slug}`}>{c.label}</a></>
        ))}
      </p>
    )}

    <div class="product-grid">
      {items.map((p) => (
        <ProductCard
          slug={p.slug}
          name={p.name}
          price={p.price}
          compareAtPrice={p.compareAtPrice}
          currency={p.currency}
          image={p.images[0]}
          inStock={p.inStock}
        />
      ))}
    </div>
  </div>

  <script>
    import '../../scripts/cart.js';
  </script>
</Layout>

<style>
  .category-page { padding: 32px 20px 64px; }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    margin-bottom: 16px;
  }
  .breadcrumb a { color: var(--color-primary); }
  .result-count { color: var(--color-ink-soft); margin-bottom: 12px; }
  .also-in { color: var(--color-ink-soft); font-size: 0.9rem; margin-bottom: 24px; }
  .also-in a { color: var(--color-primary); font-weight: 600; }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }
</style>
