---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { hasWhatsApp, whatsappLink } from '../../lib/site.js';
import { fetchProducts } from '../../lib/products.js';
import { CATEGORIES, categoryLabel, categoryGroup, menuCategories } from '../../lib/categories.js';

export async function getStaticPaths() {
  const products = await fetchProducts();
  const categories = [
    ...new Set([
      ...products.map((p) => p.category),
      ...CATEGORIES.filter((c) => c.open).map((c) => c.slug),
    ]),
  ];
  return categories.map((cat) => ({
    params: { cat },
    props: { cat, products },
  }));
}

const { cat, products } = Astro.props;
const items = products.filter((p) => p.category === cat);

const label = categoryLabel(cat);

// Other live categories in the same group (e.g. Men's Shoes <-> Ladies' Shoes <-> Gumboots)
const group = categoryGroup(cat);
const related = group
  ? menuCategories(products).filter((c) => c.group === group && c.slug !== cat)
  : [];

const base = Astro.site;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${label} — Kins Trendy Collections`,
    description: `Shop ${label.toLowerCase()} online with delivery across Kenya. Pay with M-Pesa.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', base).toString() },
      { '@type': 'ListItem', position: 2, name: label, item: new URL(`/category/${cat}`, base).toString() },
    ],
  },
];
---

<Layout
  title={`${label} Online in Kenya`}
  description={`Buy ${label.toLowerCase()} online in Kenya. Delivery across Kenya, pay with M-Pesa. Order on the website or WhatsApp.`}
  structuredData={structuredData}
  noindex={items.length === 0}
>
  <div class="container category-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <span>{label}</span>
    </nav>
    <h1>{label}</h1>
    <p class="result-count">{items.length} {items.length === 1 ? 'product' : 'products'}</p>
    {related.length > 0 && (
      <p class="also-in">
        Also in {group}:
        {related.map((c, i) => (
          <>{i > 0 ? ' · ' : ' '}<a href={`/category/${c.slug}`}>{c.label}</a></>
        ))}
      </p>
    )}

    {items.length === 0 && (
      <div class="empty-state">
        <p>We are adding {label.toLowerCase()} to the shop. Check back soon.</p>
        {hasWhatsApp && (
          <a class="btn btn-accent" href={whatsappLink(`Hi Kins Trendy Collections, do you have ${label.toLowerCase()} available?`)} target="_blank" rel="noopener noreferrer">
            Ask us on WhatsApp
          </a>
        )}
      </div>
    )}

    <div class="product-grid">
      {items.map((p) => (
        <ProductCard
          slug={p.slug}
          name={p.name}
          price={p.price}
          compareAtPrice={p.compareAtPrice}
          currency={p.currency}
          image={p.images[0]}
          inStock={p.inStock}
          category={p.category}
        />
      ))}
    </div>
  </div>

  <script>
    import '../../scripts/cart.js';
  </script>
</Layout>

<style>
  .category-page { padding: 32px 20px 64px; }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    margin-bottom: 16px;
  }
  .breadcrumb a { color: var(--color-primary); }
  .result-count { color: var(--color-ink-soft); margin-bottom: 12px; }
  .also-in { color: var(--color-ink-soft); font-size: 0.9rem; margin-bottom: 24px; }
  .empty-state { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius); padding: 28px 20px; margin-bottom: 24px; }
  .empty-state p { color: var(--color-ink-soft); margin: 0 0 14px; }
  .also-in a { color: var(--color-primary); font-weight: 600; }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }
</style>
