---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';

export function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;

const related = products
  .filter((p) => p.category === product.category && p.slug !== product.slug)
  .slice(0, 4);

const formatted = new Intl.NumberFormat('en-KE').format(product.price);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  sku: product.sku,
  image: new URL(product.images[0], Astro.site).toString(),
  offers: {
    '@type': 'Offer',
    url: new URL(`/products/${product.slug}`, Astro.site).toString(),
    priceCurrency: product.currency,
    price: product.price,
    availability: product.inStock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    areaServed: 'KE',
  },
};

const seoDescription = `Buy ${product.name} online in Kenya. ${product.shortDescription} Pay with M-Pesa or cash on delivery, delivered across Nairobi and East Africa.`;
---

<Layout
  title={product.name}
  description={seoDescription}
  image={product.images[0]}
  structuredData={structuredData}
>
  <nav class="container breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <span>/</span>
    <a href={`/category/${product.category}`}>{product.category}</a> <span>/</span>
    <span>{product.name}</span>
  </nav>

  <section class="container product-detail">
    <div class="product-image">
      <img src={product.images[0]} alt={product.name} width="500" height="500" />
      {!product.inStock && <span class="stock-flag">Out of stock</span>}
    </div>

    <div class="product-info">
      <h1>{product.name}</h1>
      <p class="price">
        {product.currency} {formatted}
        {product.compareAtPrice && (
          <span class="compare-price">
            {product.currency} {new Intl.NumberFormat('en-KE').format(product.compareAtPrice)}
          </span>
        )}
      </p>
      <p class="description">{product.description}</p>

      <button
        class="btn btn-accent add-to-cart"
        data-slug={product.slug}
        data-name={product.name}
        data-price={product.price}
        data-image={product.images[0]}
        disabled={!product.inStock}
      >
        {product.inStock ? 'Add to Cart' : 'Notify Me When Back'}
      </button>

      <ul class="fulfillment-notes">
        <li>Pay with M-Pesa at checkout, or cash on delivery</li>
        <li>Delivery within Nairobi in 1–3 days, upcountry via courier</li>
        <li>SKU: {product.sku}</li>
      </ul>
    </div>
  </section>

  {related.length > 0 && (
    <section class="container related-section">
      <h2>You may also like</h2>
      <div class="product-grid">
        {related.map((p) => (
          <ProductCard
            slug={p.slug}
            name={p.name}
            price={p.price}
            compareAtPrice={p.compareAtPrice}
            currency={p.currency}
            image={p.images[0]}
            inStock={p.inStock}
          />
        ))}
      </div>
    </section>
  )}

  <script>
    import '../../scripts/cart.js';
  </script>
</Layout>

<style>
  .breadcrumb {
    padding: 20px 20px 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .breadcrumb a { color: var(--color-ink-soft); }
  .breadcrumb span { margin: 0 6px; }

  .product-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    padding: 32px 20px 56px;
  }

  .product-image {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .product-image img { width: 100%; height: 100%; object-fit: cover; }

  .stock-flag {
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--color-rust);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius);
  }

  .product-info h1 { margin-bottom: 12px; }
  .price {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 18px;
  }
  .compare-price {
    text-decoration: line-through;
    color: var(--color-ink-soft);
    font-size: 1rem;
    font-weight: 500;
    margin-left: 10px;
  }
  .description {
    color: var(--color-ink-soft);
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .add-to-cart { padding: 14px 32px; font-size: 1rem; }
  .add-to-cart:disabled {
    background: var(--color-line);
    color: var(--color-ink-soft);
    cursor: not-allowed;
  }

  .fulfillment-notes {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
    list-style: none;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .related-section { padding: 0 20px 64px; }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  @media (max-width: 760px) {
    .product-detail { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
