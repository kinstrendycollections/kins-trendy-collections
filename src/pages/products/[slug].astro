---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { fetchProducts } from '../../lib/products.js';
import { categoryLabel, categoryGroup } from '../../lib/categories.js';
import { hasWhatsApp, whatsappLink } from '../../lib/site.js';

export async function getStaticPaths() {
  const products = await fetchProducts();
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p, allProducts: products },
  }));
}

const { product, allProducts } = Astro.props;

const related = allProducts
  .filter((p) => p.category === product.category && p.slug !== product.slug)
  .slice(0, 4);

const formatted = new Intl.NumberFormat('en-KE').format(product.price);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  sku: product.sku,
  image: product.images.map((src) => new URL(src, Astro.site).toString()),
  offers: {
    '@type': 'Offer',
    url: new URL(`/products/${product.slug}`, Astro.site).toString(),
    priceCurrency: product.currency,
    price: product.price,
    availability: product.inStock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    areaServed: 'KE',
  },
};

const productUrl = new URL(`/products/${product.slug}`, Astro.site).toString();
const isFootwear = categoryGroup(product.category) === 'Footwear';
// For shoes the message ends with "My size:" so the customer just types their size.
const waMessage =
  `Hi Kins Trendy Collections, I'd like to order: ${product.name} (KES ${formatted}). ${productUrl}` +
  (isFootwear ? '\nMy size: ' : '');
const waHref = whatsappLink(waMessage);

const seoDescription = `Buy ${product.name} online in Kenya. ${product.shortDescription} Pay with M-Pesa, delivered across Kenya.`;
---

<Layout
  title={product.name}
  description={seoDescription}
  image={product.images[0]}
  structuredData={structuredData}
  whatsappMessage={`Hi Kins Trendy Collections, I have a question about: ${product.name}. ${productUrl}`}
>
  <nav class="container breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <span>/</span>
    <a href={`/category/${product.category}`}>{categoryLabel(product.category)}</a> <span>/</span>
    <span>{product.name}</span>
  </nav>

  <section class="container product-detail">
    <div class="product-gallery">
      <div class="product-image">
        <img id="main-image" src={product.images[0]} alt={product.name} width="500" height="500" />
        {!product.inStock && <span class="stock-flag">Out of stock</span>}
      </div>
      {product.images.length > 1 && (
        <div class="thumbs">
          {product.images.map((src, i) => (
            <button type="button" class="thumb" data-src={src} aria-label={`Show photo ${i + 1}`}>
              <img src={src} alt={`${product.name} photo ${i + 1}`} loading="lazy" width="80" height="80" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="product-info">
      <h1>{product.name}</h1>
      <p class="price">
        {product.currency} {formatted}
        {product.compareAtPrice && (
          <span class="compare-price">
            {product.currency} {new Intl.NumberFormat('en-KE').format(product.compareAtPrice)}
          </span>
        )}
      </p>
      <p class="description">{product.description}</p>

      <button
        class="btn btn-accent add-to-cart"
        data-slug={product.slug}
        data-name={product.name}
        data-price={product.price}
        data-image={product.images[0]}
        data-category={product.category}
        disabled={!product.inStock}
      >
        {product.inStock ? 'Add to Cart' : 'Notify Me When Back'}
      </button>
      {hasWhatsApp && (
        <a class="btn btn-outline wa-order" href={waHref} target="_blank" rel="noopener noreferrer">
          Order on WhatsApp
        </a>
      )}

      {isFootwear && (
        <p class="size-note">
          Shoes: please send us your size on WhatsApp so we can confirm it is available.
        </p>
      )}

      <ul class="fulfillment-notes">
        <li>Pay with M-Pesa once we confirm your delivery fee</li>
        <li>Delivery across Kenya. Fee confirmed when you order. <a href="/delivery">Delivery details</a></li>
        <li>SKU: {product.sku}</li>
      </ul>
    </div>
  </section>

  {related.length > 0 && (
    <section class="container related-section">
      <h2>You may also like</h2>
      <div class="product-grid">
        {related.map((p) => (
          <ProductCard
            slug={p.slug}
            name={p.name}
            price={p.price}
            compareAtPrice={p.compareAtPrice}
            currency={p.currency}
            image={p.images[0]}
            inStock={p.inStock}
          />
        ))}
      </div>
    </section>
  )}

  <script>
    import '../../scripts/cart.js';

    // Photo gallery: clicking a small photo shows it in the big frame.
    document.querySelectorAll('.thumb').forEach((btn) => {
      btn.addEventListener('click', () => {
        const main = document.getElementById('main-image');
        if (main) main.src = btn.dataset.src;
        document.querySelectorAll('.thumb').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });
  </script>
</Layout>

<style>
  .breadcrumb {
    padding: 20px 20px 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .breadcrumb a { color: var(--color-ink-soft); }
  .breadcrumb span { margin: 0 6px; }

  .product-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    padding: 32px 20px 56px;
  }

  .product-image {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .product-image img { width: 100%; height: 100%; object-fit: cover; }

  .thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
    gap: 10px;
    margin-top: 12px;
  }
  .thumb {
    padding: 0;
    border: 2px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
    cursor: pointer;
    aspect-ratio: 1 / 1;
  }
  .thumb.active { border-color: var(--color-accent); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .stock-flag {
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--color-rust);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius);
  }

  .product-info h1 { margin-bottom: 12px; }
  .price {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 18px;
  }
  .compare-price {
    text-decoration: line-through;
    color: var(--color-ink-soft);
    font-size: 1rem;
    font-weight: 500;
    margin-left: 10px;
  }
  .description {
    color: var(--color-ink-soft);
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .add-to-cart { padding: 14px 32px; font-size: 1rem; }
  .wa-order { padding: 14px 24px; font-size: 1rem; margin-left: 10px; }
  .size-note { margin-top: 14px; color: var(--color-ink); font-weight: 600; font-size: 0.95rem; }
  .add-to-cart:disabled {
    background: var(--color-line);
    color: var(--color-ink-soft);
    cursor: not-allowed;
  }

  .fulfillment-notes {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
    list-style: none;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .related-section { padding: 0 20px 64px; }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  @media (max-width: 760px) {
    .product-detail { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
